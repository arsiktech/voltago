<?xml version="1.0" encoding="utf-8"?>
<!-- Bolt at 80 % about the 108 dp canvas centre, the same proportion as the maskable icon:
     512 - 512 * 0.8 = 102.4, 512 - 506 * 0.8 = 107.2. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:translateX="102.4"
        android:translateY="107.2"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="@string/volta_bolt_path" />
    </group>
</vector>
