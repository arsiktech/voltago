# Python
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/

# Node / frontend build output (regenerated by `npm run build`)
frontend/node_modules/
frontend/dist/
node_modules/

# Regenerable / large local-only data (kept locally, out of the repo)
data/cache/
data/source_probe/
# Presence marks a clean clone as the dedicated unattended-refresh checkout.
.volta-auto-refresh-dedicated

# Container / build scratch
*.tar

# OS / editor / logs
.DS_Store
*.log
.claude/*
!.claude/skills/
!.claude/launch.json
.idea/
.vscode/

# iOS (ios/Volta)
ios/**/xcuserdata/
ios/**/*.xcresult
ios/**/DerivedData/
ios/**/build-device/

# Syncthing / scratch (never commit sync-conflict copies or scratch dirs)
*.sync-conflict-*
/tmp/
/outputs/

# Community evidence (plan 013): user content never enters git.
# Syncthing carries data/community.db + photos between owner machines.
data/community.db*
data/community/

# Public repository: generated QA evidence stays local because it records machine
# paths and host details. Track only the ledgers and manual-test checklists.
qa/*
!qa/features.csv
!qa/test-cases.csv
!qa/defects.csv
!qa/field-test-checklist.md
!qa/voiceover-checklist.md
!qa/manual-proof-evidence-template.json
