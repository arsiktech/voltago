    "Your agent can search chargers and read their details. It cannot start charging, take payments or submit reports.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your agent can search chargers and read their details. It cannot start charging, take payments or submit reports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu agente puede buscar cargadores y consultar sus detalles. No puede iniciar una carga, realizar cobros ni enviar informes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш агент может искать зарядные станции и читать сведения о них. Он не может запускать зарядку, принимать платежи или отправлять отчёты."
          }
        }
      }
    },
    "Live availability depends on source coverage. Directory listings do not show whether a charger is available or occupied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live availability depends on source coverage. Directory listings do not show whether a charger is available or occupied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilidad en directo depende de la cobertura de las fuentes. Las listas de directorio no indican si un cargador está disponible u ocupado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступность в реальном времени зависит от покрытия источников. Записи в справочнике не показывают, свободна или занята зарядная станция."
          }
        }
      }
