    "City searches are relayed by the Volta service to Nominatim. The service may cache requests and results, and logs the client IP address for security and rate limiting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City searches are relayed by the Volta service to Nominatim. The service may cache requests and results, and logs the client IP address for security and rate limiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de Volta reenvía las búsquedas de ciudades a Nominatim. El servicio puede almacenar en caché las solicitudes y los resultados, y registra la dirección IP del cliente por seguridad y para limitar la frecuencia de uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис Volta перенаправляет поиск городов в Nominatim. Сервис может кэшировать запросы и результаты, а также регистрирует IP-адрес клиента для защиты и ограничения частоты запросов."
          }
        }
      }
