    "Volta helps you compare public charger evidence. Availability, price, parking, and access can change; verify the station before routing or charging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta helps you compare public charger evidence. Availability, price, parking, and access can change; verify the station before routing or charging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta te ayuda a comparar datos públicos sobre cargadores. La disponibilidad, el precio, el aparcamiento y el acceso pueden cambiar; verifica la estación antes de dirigirte a ella o cargar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta помогает сравнивать открытые данные о зарядных станциях. Доступность, цена, парковка и доступ могут измениться; проверьте станцию перед поездкой или зарядкой."
          }
        }
      }
    },
    "Volta Plus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus"
          }
        }
      }
    },
    "Volta Plus is account-less and tied to the Apple ID used for App Store purchases. Apple handles payment, renewal, cancellation, restoration, and refunds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus is account-less and tied to the Apple ID used for App Store purchases. Apple handles payment, renewal, cancellation, restoration, and refunds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus no requiere cuenta y está vinculado al Apple ID utilizado para las compras del App Store. Apple gestiona el pago, la renovación, la cancelación, la restauración y los reembolsos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus не требует аккаунта и связан с Apple ID, использованным для покупок в App Store. Apple обрабатывает оплату, продление, отмену, восстановление и возвраты."
          }
        }
      }
    },
    "Volta Plus is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus está listo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta Plus готов."
          }
        }
      }
    },
    "Volta sends searches and visible map areas to the configured Volta service when you search or move the map. After location permission is granted, precise coordinates are also sent when the app opens and when you ask to find or rank nearby chargers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta sends searches and visible map areas to the configured Volta service when you search or move the map. After location permission is granted, precise coordinates are also sent when the app opens and when you ask to find or rank nearby chargers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta envía las búsquedas y las áreas visibles del mapa al servicio de Volta configurado cuando buscas o mueves el mapa. Tras conceder permiso de ubicación, también envía las coordenadas precisas al abrir la app y cuando pides buscar u ordenar cargadores cercanos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta отправляет поисковые запросы и видимые области карты настроенному сервису Volta, когда вы выполняете поиск или перемещаете карту. После разрешения доступа к геопозиции точные координаты также отправляются при открытии приложения и когда вы просите найти или ранжировать ближайшие зарядные станции."
          }
        }
      }
    },
    "Volta service": {
      "extractionState": "manual",
      "localizations": {
