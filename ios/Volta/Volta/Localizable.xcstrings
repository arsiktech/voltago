    "Opens your car's battery, range and connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens your car's battery, range and connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la batería, autonomía y conexión del coche"
          }
        },
        "ru": {
