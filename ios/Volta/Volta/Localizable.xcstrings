  "strings": {
    "Showing part of this area’s charger inventory. Zoom in or search a city to see more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing part of this area’s charger inventory. Zoom in or search a city to see more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra parte de los cargadores de esta zona. Acerca el mapa o busca una ciudad para ver más."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показана часть зарядных станций в этой области. Увеличьте карту или найдите город, чтобы увидеть больше."
          }
        }
      }
    },
    "·": {
      "extractionState": "manual",
      "localizations": {
