    "%@ is charged now and renews every %@ until cancelled. Cancel in App Store subscription settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is charged now and renews every %2$@ until cancelled. Cancel in App Store subscription settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cobra %1$@ ahora y se renueva cada %2$@ hasta que se cancele. Cancela en los ajustes de suscripciones del App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плата %1$@ списывается сейчас, затем подписка продлевается каждые %2$@ до отмены. Отменить подписку можно в настройках подписок App Store."
          }
        }
      }
    },
