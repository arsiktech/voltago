          "stringUnit": {
            "state": "translated",
            "value": "Do not interact with Volta while driving. Follow road rules, posted parking conditions, and charger operator instructions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No interactúes con Volta mientras conduces. Respeta las normas de tráfico, las condiciones de aparcamiento indicadas y las instrucciones del operador del cargador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пользуйтесь Volta во время вождения. Соблюдайте правила дорожного движения, указанные условия парковки и инструкции оператора зарядной станции."
          }
        }
      }
    },
