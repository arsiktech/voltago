    "Planning estimate. Time assumes peak power; charging slows near full. Energy cost includes an assumed 10% charging loss, excluding parking, time and session fees.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planning estimate. Time assumes peak power; charging slows near full. Energy cost includes an assumed 10% charging loss, excluding parking, time and session fees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación orientativa. El tiempo supone potencia máxima; la carga se ralentiza al llenarse. El coste supone un 10% de pérdidas y excluye aparcamiento, tiempo y cargos por sesión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка для планирования. Время рассчитано по пиковой мощности; ближе к полному заряду скорость падает. Стоимость учитывает условные 10% потерь без парковки, платы за время и сессию."
          }
        }
      }
    },
