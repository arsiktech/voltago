    "Eligible now: %@ free. Then %@ every %@ until cancelled. Eligibility is confirmed by the App Store. Cancel in App Store subscription settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligible now: %1$@ free. Then %2$@ every %3$@ until cancelled. Eligibility is confirmed by the App Store. Cancel in App Store subscription settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible ahora: %1$@ gratis. Después, %2$@ cada %3$@ hasta que se cancele. El App Store confirma si cumples los requisitos. Cancela en los ajustes de suscripciones del App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас доступно бесплатно на %1$@. Затем — %2$@ каждые %3$@ до отмены. App Store подтверждает право на пробный период. Отменить подписку можно в настройках подписок App Store."
          }
        }
      }
    },
