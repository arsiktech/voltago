    "Questions about privacy, access, or deletion can be sent through Volta Support. You can stop location sharing in iOS Settings and remove on-device preferences by deleting the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions about privacy, access, or deletion can be sent through Volta Support. You can stop location sharing in iOS Settings and remove on-device preferences by deleting the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes enviar preguntas sobre privacidad, acceso o eliminación al soporte de Volta. Puedes detener el uso de la ubicación en Ajustes de iOS y borrar las preferencias del dispositivo eliminando la app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы о конфиденциальности, доступе или удалении можно направить в поддержку Volta. Передачу геопозиции можно отключить в настройках iOS, а локальные настройки удалить вместе с приложением."
          }
        }
      }
    },
